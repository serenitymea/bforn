# Скопіюй цей файл в .env для локальної розробки
# На Railway ці змінні встановлюються через Dashboard → Variables

BOT_TOKEN=your_bot_token_here
ADMIN_USER_ID=123456789
ADMIN_USERNAME=your_telegram_username

# Локальна БД (якщо не використовуєш Railway Postgres)
DATABASE_URL=postgresql://botuser:password@localhost:5432/botdb

# Або окремі параметри підключення:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=botdb
# POSTGRES_USER=botuser
# POSTGRES_PASSWORD=password
